# Intern onboarding module. All four are REQUIRED — the module refuses to run
# without them, because it handles Aadhaar data.

# Signs the admin session cookie and encrypts temporary mailbox passwords.
# Generate with: openssl rand -base64 48
# Changing it invalidates admin sessions and any password not yet collected.
ONBOARDING_SECRET=

# Shared passcode for the founders' console at /hr/admin.
ONBOARDING_ADMIN_PASSCODE=

# Supabase project holding candidate records and Aadhaar copies.
# Settings → API in the Supabase dashboard.
SUPABASE_URL=https://lvfdrhvpukkdmxziwtnn.supabase.co

# The SERVICE ROLE key, not the anon/publishable one — the tables have RLS on
# with no policies, so nothing else can reach them. It bypasses all row
# security: keep it server-side only, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Focus Realm Workspace (the employee app). OPTIONAL. With both set, everyone
# added here gets a Workspace login — an employee ID like FR-0042 and a
# temporary password, shown once. With either unset, every Workspace call is
# skipped and the console works exactly as before. Server-only, like
# everything above: never prefix these with NEXT_PUBLIC_.

# The Workspace's address, e.g. https://workspace.focusrealm.com
FOCUS_REALM_WORKSPACE_URL=

# The same value as HR_WEBHOOK_SECRET on the Workspace.
# Generate with: openssl rand -hex 32
FOCUS_REALM_WORKSPACE_SECRET=
