# Intern onboarding module. All four are REQUIRED — the module refuses to run
# without them, because it handles Aadhaar data.

# Signs the admin session cookie and encrypts temporary mailbox passwords.
# Generate with: openssl rand -base64 48
# Changing it invalidates admin sessions and any password not yet collected.
ONBOARDING_SECRET=

# Shared passcode for the founders' console at /hr/admin.
ONBOARDING_ADMIN_PASSCODE=

# Supabase project holding candidate records and Aadhaar copies.
# Settings → API in the Supabase dashboard.
SUPABASE_URL=https://lvfdrhvpukkdmxziwtnn.supabase.co

# The SERVICE ROLE key, not the anon/publishable one — the tables have RLS on
# with no policies, so nothing else can reach them. It bypasses all row
# security: keep it server-side only, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Focus Realm Workspace (the employee app). OPTIONAL. With both set, everyone
# added here gets a Workspace login — an employee ID like FR-0042 and a
# temporary password, shown once. With either unset, every Workspace call is
# skipped and the console works exactly as before. Server-only, like
# everything above: never prefix these with NEXT_PUBLIC_.

# The Workspace's address, e.g. https://workspace.focusrealm.com
FOCUS_REALM_WORKSPACE_URL=

# The same value as HR_WEBHOOK_SECRET on the Workspace.
# Generate with: openssl rand -hex 32
FOCUS_REALM_WORKSPACE_SECRET=

# Signs the nightly Vercel Cron call that makes leavers former employees in
# the Workspace (vercel.json). Generate with: openssl rand -hex 32
CRON_SECRET=

# Cloudflare R2 for uploaded files (Aadhaar copies, agreements). OPTIONAL, but
# recommended: 10 GB free. With all four set, new uploads go to R2 and files
# are read from R2 first, then the Supabase bucket. With any unset, files stay
# on Supabase. Copy existing files across with: npm run uploads:copy-to-r2
# Server-only — these keys can read every Aadhaar copy.

# Cloudflare dashboard → R2 → Overview (the Account ID).
R2_ACCOUNT_ID=
# R2 → Manage API tokens → Create token: "Object Read & Write", limited to the bucket below.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# A PRIVATE bucket: no public access, no r2.dev URL, no custom domain.
R2_BUCKET=

# Focus Realm Sales CRM. OPTIONAL. With both set, people in the sales
# department ONLY (Business Development or another sales role) also get a CRM
# login with their Workspace employee ID. No other department is ever synced.
# With either unset, every CRM call is skipped. Server-only: never NEXT_PUBLIC_.

# The CRM's address, e.g. https://crm.focusrealm.com
FOCUS_REALM_CRM_URL=

# The same value as HR_WEBHOOK_SECRET on the CRM.
# Generate with: openssl rand -hex 32
FOCUS_REALM_CRM_SECRET=

# The single Focus Realm website. OPTIONAL — set only AFTER the Workspace routes
# /hr, /hr-static, /api/onboarding and /launch to this app (see README "One website").
# With both set: founders open the console from the Workspace's app switcher,
# this app's own Vercel address redirects to the website, and the passcode
# stays as a fallback. Needs a redeploy (the asset prefix is set at build time).
# The website's address, e.g. https://employee-management.vercel.app
FOCUS_REALM_HUB_URL=
# Shared with the Workspace (and the CRM). Generate with: openssl rand -hex 32
FOCUS_REALM_HUB_SECRET=
